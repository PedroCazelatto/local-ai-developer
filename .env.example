OLLAMA_NUM_CTX=16384
# Summarization failsafe (V4/05): compact a phase once its EXACT prompt_eval_count reaches
# this fraction of OLLAMA_NUM_CTX. 0.75 leaves headroom for the next response; must be in (0, 1].
SUMMARIZATION_THRESHOLD_RATIO=0.75
# How long ONE model call may go SILENT before it is abandoned, in milliseconds. This is a stall
# window, not a limit on how long a turn may take: every chunk restarts it, so a 14-32b model that
# spends nine legitimate minutes on a turn never trips it, while a wedged or unreachable daemon
# surfaces as one recoverable line instead of a REPL that hangs forever. A one-shot (summarization,
# search_rules, the context titler) has no chunks to restart it, so this caps the whole call.
OLLAMA_TIMEOUT_MS=120000
