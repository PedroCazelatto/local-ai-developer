{
  "name": "local-ai-developer",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript/Node CLI that orchestrates a locally-run Ollama model to autonomously develop code projects.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/run.mjs install",
    "start": "node scripts/run.mjs start",
    "stop": "node scripts/run.mjs stop",
    "dev": "tsx --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.3.0",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.0",
    "ignore": "^7.0.6",
    "js-yaml": "^5.2.1",
    "ollama": "^0.5.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
