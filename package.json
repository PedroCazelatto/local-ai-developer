{
  "name": "local-ai-developer",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript/Node CLI that orchestrates a locally-run Ollama model to autonomously develop code projects.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.3.0",
    "dockerode": "^4.0.0",
    "dotenv": "^16.4.0",
    "ollama": "^0.5.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
